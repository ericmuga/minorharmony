# /etc/systemd/system/serviam.service
[Unit]
Description=Serviam API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/serviam/server
EnvironmentFile=/var/www/serviam/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
