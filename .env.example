# ---- copy to .env on the VPS and fill in ----
NODE_ENV=production
PORT=8787

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite file lives (relative to /server or absolute)
DB_PATH=./data/serviam.db

# Set true once you are behind HTTPS (nginx + certbot). Makes the cookie Secure.
SECURE_COOKIES=true

# Your domain, used for cookie + CORS in dev only
APP_ORIGIN=https://serviam.minorharmony.com

# ---- AI: daily briefing + strategist (server-side only) ----
# Get a key at console.anthropic.com. Never put this in the frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
